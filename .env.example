# Voice Assistant configuration
# Copy to .env and adjust: cp .env.example .env
# Docker Compose reads this file automatically.

# Base URL of the llama.cpp server (the /completion path is appended
# automatically). The container runs in host network mode, so any
# host-reachable address works (loopback, LAN IP, hostname).
LLM_ENDPOINT=http://127.0.0.1:8080
