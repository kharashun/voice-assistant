# Voice Assistant configuration
# Copy to .env and adjust: cp .env.example .env
# Docker Compose reads this file automatically.

# Base URL of the llama.cpp server (the /v1/chat/completions path is
# appended automatically). The container runs on a bridge network with the
# host-gateway alias, so the default reaches a server on the host; that
# server must listen on the bridge gateway (e.g. --host 0.0.0.0), not only
# on loopback.
LLM_ENDPOINT=http://host.docker.internal:8080

# Host GID of the audio group, added to the container's non-root user so it
# can open the /dev/snd devices. 29 is the usual value on Ubuntu; check with
# `getent group audio`.
#AUDIO_GID=29

# Model name sent with every request. Required when the llama.cpp server
# runs in router mode (--models-dir / --model-presets), which rejects
# requests without it ("model name is missing from the request");
# single-model servers ignore it. Leave empty to omit the field.
#LLM_MODEL=your-model-name

# System prompt shaping the assistant's replies. Empty value falls back to
# the built-in default.
#LLM_SYSTEM_PROMPT=You are a voice assistant. Reply in one or two short sentences.

# Number of CPU threads whisper-cli uses for STT (passed as -t). whisper-cli
# defaults to only 4 threads; set this to your host's physical core count to
# speed up STT with the larger small.en-q5_1 model. Leave empty for the
# whisper-cli default.
#WHISPER_THREADS=8

# Disable the model's thinking/reasoning mode. Sent as
# chat_template_kwargs {"enable_thinking": false}, which Qwen3-style
# templates honor; llama.cpp has no "reasoning" request field. On by
# default, because a thinking model spends the whole token budget on
# reasoning and returns an empty answer. Set to false to allow reasoning,
# and then raise LLM_MAX_TOKENS too (thinking needs ~400+ tokens).
#LLM_DISABLE_REASONING=false

# Token budget for each LLM reply. 512 leaves room for a model that still
# thinks (reasoning + answer); once reasoning is disabled, lower it
# (e.g. 100) to cap worst-case latency.
#LLM_MAX_TOKENS=512

# Voice-activated capture (sox `silence` effect): the assistant waits for
# speech, records until you pause for VAD_SILENCE_SEC, then processes.
# Set CAPTURE_MODE=fixed to restore the old fixed-window behavior
# (window length via CAPTURE_SECONDS, default 5).
#CAPTURE_MODE=vad

# sox amplitude threshold (%) that starts the recording. Tune for your
# mic/room: too low starts recordings on fan/keyboard noise, too high
# misses quiet speech onset.
#VAD_THRESHOLD=10

# sox amplitude threshold (%) that resets the end-of-speech counter:
# only sound above this keeps the recording going, so in a noisy room set
# it above the noise peaks (measure with: sox -d -r 16000 -c 1 -b 16
# /tmp/n.wav trim 0 5 && sox /tmp/n.wav -n stat -> "Maximum amplitude").
# Unset/0 keeps it identical to VAD_THRESHOLD (symmetric behavior).
#VAD_STOP_THRESHOLD=30

# Sound duration (ms) that starts the recording (guards against clicks).
#VAD_START_MS=100

# Quiet duration (s) that ends the utterance - the end-of-speech pause.
# Only sound above VAD_STOP_THRESHOLD interrupts this countdown, so with
# the stop threshold above the room noise it can safely be lowered.
# Lower = snappier response but mid-sentence thinking pauses cut you off.
#VAD_SILENCE_SEC=2.0

# Hard cap on one utterance (s) so continuous noise cannot record forever.
#VAD_MAX_UTTERANCE_SEC=30

# Captures shorter than this (ms) are skipped before STT - transient noise
# that triggered the recording but contains no speech.
#VAD_MIN_SPEECH_MS=500

# Seconds of silence before the session auto-resets (full conversation
# clear). Checked when the next capture ends, so a returning user's
# utterance starts a fresh conversation instead of reviving stale context.
# Set to 0 to disable the timeout entirely.
#SESSION_TIMEOUT_SEC=60

# Max messages in session history (even number, e.g. 6/10/20).
# Must be > 0 and even (messages are trimmed in pairs).
#SESSION_MAX_MESSAGES=10

# Utterance that resets the conversation. Matched case- and
# punctuation-insensitively ("New voice-assistant session." works), with
# room for a couple of padding words ("um ... please"); a longer sentence
# that merely mentions the phrase does not reset anything.
#SESSION_RESET_PHRASE=new voice assistant session

# Whisper.cpp Silero VAD model (ggml). Downloaded by install_models.sh; a
# missing file just disables whisper's --vad (non-speech filtering).
# Point it at ggml-silero-v6.2.0.bin to try the newer model.
#WHISPER_VAD_MODEL=/models/whisper/ggml-silero-v5.1.2.bin

# Enable sentence-chunked streaming TTS (requires the persistent piper
# process to start; otherwise the reply is spoken whole). The LLM reply
# is requested as an SSE stream and each completed sentence is spoken
# while the rest is still generating, so the first sentence is heard
# much sooner. Listening resumes only after playback finishes.
# Requires llama.cpp to support "stream": true on /v1/chat/completions.
#LLM_STREAM=false

# Overall deadline for one LLM request, headers through the last SSE
# event when streaming (Go duration).
#LLM_TIMEOUT=30s
