# Voice Assistant configuration
# Copy to .env and adjust: cp .env.example .env
# Docker Compose reads this file automatically.

# Base URL of the llama.cpp server (the /v1/chat/completions path is
# appended automatically). The container runs on a bridge network with the
# host-gateway alias, so the default reaches a server on the host; that
# server must listen on the bridge gateway (e.g. --host 0.0.0.0), not only
# on loopback.
LLM_ENDPOINT=http://host.docker.internal:8080

# Host GID of the audio group, added to the container's non-root user so it
# can open the /dev/snd devices. 29 is the usual value on Ubuntu; check with
# `getent group audio`.
#AUDIO_GID=29

# Model name sent with every request. Required when the llama.cpp server
# runs in router mode (--models-dir / --model-presets), which rejects
# requests without it ("model name is missing from the request");
# single-model servers ignore it. Leave empty to omit the field.
#LLM_MODEL=your-model-name

# System prompt shaping the assistant's replies. Empty value falls back to
# the built-in default.
#LLM_SYSTEM_PROMPT=You are a voice assistant. Reply in one or two short sentences.

# Number of CPU threads whisper-cli uses for STT (passed as -t). whisper-cli
# defaults to only 4 threads; set this to your host's physical core count to
# speed up STT with the larger small.en-q5_1 model. Leave empty for the
# whisper-cli default.
#WHISPER_THREADS=8
