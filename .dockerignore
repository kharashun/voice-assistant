# Git
.git
.gitignore

# Documentation (THIRD_PARTY_NOTICES.md and the extension-less LICENSES/
# files are COPYed into the image, so they must stay in the build context)
*.md
*.txt
!THIRD_PARTY_NOTICES.md

# Build outputs
build/
dist/
*.log
voice-assistant

# Models (mounted at runtime, not part of the build context)
models/
*.bin
*.onnx

# Voices (if any)
voices/
